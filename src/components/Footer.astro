---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-inner">
      <div class="footer-brand">
        <a href="/" class="footer-logo">
          <span class="logo-wordmark"><span class="logo-accent">Game</span><span class="logo-blue">Dev</span><span class="logo-text">Dolin</span></span>
        </a>
        <p class="footer-tagline">Narrative design, writing, and game development consulting.</p>
      </div>

      <div class="footer-links">
        <div class="footer-col">
          <h4>Site</h4>
          <ul>
            <li><a href="/about">About</a></li>
            <li><a href="/work">Work</a></li>
            <li><a href="/services">Services</a></li>
            <li><a href="/contact">Contact</a></li>
            <li><a href="/lily">Lily</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Connect</h4>
          <ul>
            <li><a href="https://linkedin.com/in/adamdolin" target="_blank" rel="noopener">LinkedIn</a></li>
            <li><a href="https://bsky.app/profile/gamedevdolin.com" target="_blank" rel="noopener">Bluesky</a></li>
            <li><a href="mailto:adam@gamedevdolin.com">Email</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {currentYear} Adam Dolin. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    padding: var(--space-3xl) 0 var(--space-xl);
    background: var(--color-bg-alt);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3xl);
    margin-bottom: var(--space-3xl);
  }

  .footer-brand {
    max-width: 320px;
  }

  .footer-logo {
    font-size: 1.25rem;
    font-weight: 700;
    text-decoration: none;
    display: inline-block;
    margin-bottom: var(--space-sm);
  }

  .logo-text { color: var(--color-white); }
  .logo-blue { color: var(--color-blue); }
  .logo-accent { color: var(--color-accent); }

  .footer-tagline {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    margin-bottom: 0;
  }

  .footer-links {
    display: flex;
    gap: var(--space-3xl);
  }

  .footer-col h4 {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }

  .footer-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer-col a {
    color: var(--color-text);
    font-size: 0.9375rem;
    transition: color var(--transition-fast);
    text-decoration: none;
  }

  .footer-col a:hover {
    color: var(--color-accent);
  }

  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-xl);
  }

  .footer-bottom p {
    font-size: 0.8125rem;
    color: var(--color-text-dim);
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .footer-inner {
      flex-direction: column;
      gap: var(--space-2xl);
    }
  }
</style>
