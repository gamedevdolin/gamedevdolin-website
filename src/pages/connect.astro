---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Connect with Adam Dolin"
  description="Adam Dolin — Narrative Designer, Writer, and Game Development Consultant. Add me on LinkedIn or save my contact."
>
  <section class="connect">
    <div class="container">
      <div class="connect-card">
        <img src="/images/about/headshot-square.jpg" alt="Adam Dolin" class="connect-headshot" />
        <h1>Adam Dolin</h1>
        <span class="label">Narrative Design &bull; Writing &bull; Creative Consulting</span>

        <div class="connect-actions">
          <a
            href="https://www.linkedin.com/in/adamdolin/"
            target="_blank"
            rel="noopener"
            class="btn connect-linkedin"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
            Add me on LinkedIn
          </a>
          <a href="/files/adam-dolin.vcf" class="btn btn-outline connect-save">Save my contact</a>
        </div>

        <nav class="connect-links" aria-label="Site links">
          <a href="/work">See my work &rarr;</a>
          <a href="/services">Consulting &amp; services &rarr;</a>
          <a href="/contact">Get in touch &rarr;</a>
        </nav>

        <a href="/" class="connect-home">Explore the full site</a>

        <div class="connect-qr">
          <a
            href="https://www.linkedin.com/in/adamdolin/"
            target="_blank"
            rel="noopener"
            aria-label="Adam Dolin on LinkedIn"
          >
            <img src="/images/linkedin-qr.svg" alt="QR code linking to Adam Dolin's LinkedIn profile" width="160" height="160" />
          </a>
          <span>Scan to connect on LinkedIn</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .connect {
    display: flex;
    align-items: center;
    min-height: calc(100vh - var(--nav-height));
    padding: var(--space-xl) 0 var(--space-2xl);
  }

  .connect-card {
    max-width: 420px;
    margin: 0 auto;
    text-align: center;
  }

  .connect-headshot {
    width: 124px;
    height: 124px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--color-border);
    margin: 0 auto var(--space-md);
  }

  .connect-card h1 {
    font-size: 2rem;
    margin-bottom: var(--space-xs);
    letter-spacing: -0.02em;
  }

  .connect-card .label {
    display: block;
    margin-bottom: var(--space-xl);
  }

  .connect-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  .connect-linkedin {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6em;
    width: 100%;
    padding: 1rem;
    font-size: 1.0625rem;
    font-weight: 600;
    background: #0a66c2;
    color: var(--color-white);
    border: none;
  }

  .connect-linkedin:hover {
    background: #0e76de;
    color: var(--color-white);
  }

  .connect-linkedin svg {
    width: 1.25em;
    height: 1.25em;
    flex-shrink: 0;
  }

  .connect-save {
    width: 100%;
    padding: 0.875rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .connect-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  .connect-links a {
    color: var(--color-text-muted);
    padding: var(--space-xs) 0;
    transition: color var(--transition-base);
  }

  .connect-links a:hover {
    color: var(--color-text);
  }

  .connect-home {
    font-size: 0.875rem;
    color: var(--color-text-dim);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .connect-qr {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-2xl);
  }

  .connect-qr img {
    display: block;
    width: 160px;
    height: 160px;
    padding: var(--space-sm);
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 12px;
  }

  .connect-qr span {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
</style>
