---
import BaseLayout from '../layouts/BaseLayout.astro';

const services = [
  {
    icon: "&#9998;",
    title: "Story & Narrative Design",
    items: [
      "Story outlining and structure",
      "Worldbuilding and lore development",
      "Quest and mission narrative design",
      "Branching dialogue systems",
      "Narrative documentation and bibles",
    ],
  },
  {
    icon: "&#128221;",
    title: "Writing",
    items: [
      "Dialogue writing (cinematic and in-game)",
      "Barks, ambient dialogue, and systemic writing",
      "Character development and voice",
      "Script editing and polish",
      "Localization-friendly writing practices",
    ],
  },
  {
    icon: "&#127908;",
    title: "Voice & Performance",
    items: [
      "Voiceover direction",
      "Casting and talent coordination",
      "Performance capture consulting",
      "Dialogue pipeline design",
      "Studio and session management",
    ],
  },
  {
    icon: "&#128101;",
    title: "Team & Production",
    items: [
      "Narrative team structure and hiring",
      "Team dynamics and communication",
      "Cross-discipline collaboration",
      "Production pipeline consulting",
      "Conflict resolution and coaching",
    ],
  },
  {
    icon: "&#127891;",
    title: "Coaching & Mentorship",
    items: [
      "1-on-1 career coaching for game writers",
      "Portfolio and resume review",
      "Writing team mentorship programs",
      "Breaking into the games industry",
      "GDC and conference preparation",
    ],
  },
  {
    icon: "&#127918;",
    title: "Playtesting & UX",
    items: [
      "Narrative-focused playtesting",
      "UX review for story delivery",
      "Player comprehension analysis",
      "Pacing and flow evaluation",
      "Feedback synthesis and reporting",
    ],
  },
];
---

<BaseLayout title="Services — Adam Dolin" description="Narrative design, writing, voice production, and game development consulting services.">

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="label">Services</span>
        <h1>How I can help</h1>
        <p>I work with studios of all sizes — from solo indie devs to AAA publishers — on narrative, writing, voice production, and team health. Engagements range from a single consultation to ongoing embedded work.</p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="grid grid-2">
        {services.map((service) => (
          <div class="card service-detail">
            <div class="service-detail-header">
              <span class="service-detail-icon" set:html={service.icon} />
              <h3>{service.title}</h3>
            </div>
            <ul class="service-items">
              {service.items.map(item => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section process-section">
    <div class="container">
      <div class="section-header">
        <span class="label">Process</span>
        <h2>How I typically work</h2>
      </div>

      <div class="process-steps">
        <div class="process-step">
          <span class="step-number">01</span>
          <h3>Discovery Call</h3>
          <p>We talk about your project, where you're at, and what kind of help would actually be useful. No commitment, no pitch — just a conversation.</p>
        </div>
        <div class="process-step">
          <span class="step-number">02</span>
          <h3>Scope & Proposal</h3>
          <p>Based on what we discuss, I'll put together a clear proposal with scope, timeline, and pricing. I'm upfront about what I can and can't do.</p>
        </div>
        <div class="process-step">
          <span class="step-number">03</span>
          <h3>Embedded Work</h3>
          <p>I integrate with your team's workflow — Slack, Jira, Google Docs, whatever you use. I work the way your team works, not the other way around.</p>
        </div>
        <div class="process-step">
          <span class="step-number">04</span>
          <h3>Handoff & Follow-up</h3>
          <p>Deliverables are clean, documented, and designed to outlast the engagement. I want the work to be useful long after I'm gone.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-box">
        <h2>Interested in working together?</h2>
        <p>Tell me about your project and I'll get back to you within a couple days.</p>
        <a href="/contact" class="btn btn-primary">Get in Touch</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .service-detail {
    display: flex;
    flex-direction: column;
  }

  .service-detail-header {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }

  .service-detail-icon {
    font-size: 1.5rem;
  }

  .service-detail-header h3 {
    font-size: 1.125rem;
    margin: 0;
  }

  .service-items {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .service-items li {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    padding-left: var(--space-lg);
    position: relative;
  }

  .service-items li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--color-text-dim);
  }

  /* Process */
  .process-section {
    background: var(--color-bg-alt);
  }

  .process-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-xl);
  }

  .process-step {
    padding: var(--space-lg);
  }

  .step-number {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-accent);
    margin-bottom: var(--space-md);
    font-family: var(--font-mono);
  }

  .process-step h3 {
    font-size: 1.0625rem;
    margin-bottom: var(--space-sm);
  }

  .process-step p {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin-bottom: 0;
    line-height: 1.6;
  }

  /* CTA */
  .cta-box {
    text-align: center;
    padding: var(--space-3xl);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 16px;
  }

  .cta-box h2 {
    margin-bottom: var(--space-md);
  }

  .cta-box p {
    max-width: 480px;
    margin: 0 auto var(--space-xl);
    color: var(--color-text-muted);
  }
</style>
