---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Message Sent — Adam Dolin" description="Thanks for reaching out — your message has been sent.">

  <section class="section">
    <div class="container">
      <div class="thanks-content">
        <span class="label">Message Sent</span>
        <h1>Thanks for reaching out.</h1>
        <p class="thanks-intro">
          Your message is on its way. I typically respond within 1-2 business days —
          in the meantime, feel free to poke around.
        </p>
        <div class="thanks-actions">
          <a href="/" class="btn btn-primary">Back to Home</a>
          <a href="/work" class="btn btn-outline">See My Work</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .thanks-content {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
    padding: var(--space-3xl) 0;
  }

  .thanks-content h1 {
    margin-bottom: var(--space-md);
  }

  .thanks-intro {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: var(--space-2xl);
  }

  .thanks-actions {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
