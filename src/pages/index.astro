---
import BaseLayout from '../layouts/BaseLayout.astro';

const studios = [
  {
    name: "Santa Monica Studio",
    slug: "santa-monica-studio",
    logo: "/images/logos/santa.png",
    projects: [
      { title: "God of War: Ragnarök", role: "Narrative Designer & Writer", year: "2022" },
      { title: "God of War (2018)", role: "Narrative Designer & Writer", year: "2018" },
    ],
  },
  {
    name: "Guerrilla Games",
    slug: "guerrilla-games",
    logo: "/images/logos/guerrilla.png",
    projects: [
      { title: "Horizon Forbidden West", role: "Narrative Designer", year: "2022" },
    ],
  },
  {
    name: "Night School Studio",
    slug: "night-school-studio",
    logo: "/images/logos/nightschool.jpg",
    projects: [
      { title: "Night School Studio", role: "Lead Narrative Designer", year: "" },
    ],
  },
  {
    name: "Sledgehammer Games",
    slug: "sledgehammer-games",
    logo: "/images/logos/sledge.png",
    projects: [
      { title: "Call of Duty: Advanced Warfare", role: "Dialog Supervisor", year: "2014" },
    ],
  },
  {
    name: "PlayStation",
    slug: "playstation",
    logo: "/images/logos/playstation.png",
    projects: [
      { title: "Uncharted 4: A Thief's End", role: "Casting & Talent Coordinator", year: "2016" },
      { title: "Uncharted: The Lost Legacy", role: "Dialog Coordinator & Editor", year: "2017" },
    ],
  },
  {
    name: "Activision",
    slug: "activision",
    logo: "/images/logos/activision.png",
    projects: [
      { title: "Call of Duty: Advanced Warfare", role: "Dialog Supervisor", year: "2014" },
    ],
  },
  {
    name: "2K Games",
    slug: "2k-games",
    logo: "/images/logos/2kgames.png",
    projects: [
      { title: "2K Games", role: "Narrative Consultant", year: "" },
    ],
  },
  {
    name: "Firaxis Games",
    slug: "firaxis-games",
    logo: "/images/logos/firax3.png",
    projects: [
      { title: "Firaxis Games", role: "Narrative Consultant", year: "" },
    ],
  },
  {
    name: "SEGA",
    slug: "sega",
    logo: "",
    projects: [
      { title: "SEGA", role: "Narrative Consultant", year: "" },
    ],
  },
  {
    name: "Netflix Games",
    slug: "netflix-games",
    logo: "",
    projects: [
      { title: "Netflix Games", role: "Narrative Consultant", year: "" },
    ],
  },
  {
    name: "Turtle Rock Studios",
    slug: "turtle-rock-studios",
    logo: "",
    projects: [
      { title: "Turtle Rock Studios", role: "Narrative Consultant", year: "" },
    ],
  },
  {
    name: "The Halp Network",
    slug: "the-halp-network",
    logo: "",
    projects: [
      { title: "The Halp Network", role: "Narrative Consultant", year: "" },
    ],
  },
];
---

<BaseLayout title="Adam Dolin — Narrative Designer & Game Dev Consultant">

  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero-layout">
        <div class="hero-content">
          <span class="label">Narrative Design &bull; Writing &bull; Creative Consulting</span>
          <h1>I help game makers tell better stories.</h1>
          <p class="hero-sub">
            I'm Adam Dolin — a writer and designer of video games since 2009.
            I've worked on titles like <strong>God of War</strong>, <strong>Horizon: Forbidden West</strong>,
            and <strong>God of War: Ragnar&ouml;k</strong>. Now I consult with studios of all sizes
            on narrative design, writing, and creative direction.
          </p>
          <div class="hero-actions">
            <a href="/work" class="btn btn-primary">See My Work</a>
            <a href="/contact" class="btn btn-outline">Get in Touch</a>
            <a
              href="https://www.linkedin.com/in/adamdolin/"
              target="_blank"
              rel="noopener"
              class="btn btn-outline social-btn"
              aria-label="Adam Dolin on LinkedIn"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
            </a>
          </div>
        </div>
        <div class="hero-logo">
          <img src="/images/logos/GDD_logo-1000px.png" alt="GameDevDolin logo" />
        </div>
      </div>
    </div>
  </section>

  <!-- Currently Working On -->
  <section class="section currently-section">
    <div class="container">
      <div class="currently-bar">
        <span class="currently-pulse"></span>
        <span class="currently-label">Current Projects</span>
      </div>
      <div class="currently-items">
<a href="https://store.steampowered.com/app/2795110/Petal_Runner/" target="_blank" rel="noopener" class="currently-item currently-link">
          <div class="currently-img-wrap">
            <img src="/images/currentwork/petalrunner.jpg" alt="Petal Runner" class="currently-img" />
          </div>
          <div class="currently-info">
            <span class="currently-tag tag-blue">Creative Consulting</span>
            <span class="currently-text">Petal Runner — Wishlist now on Steam!</span>
          </div>
        </a>
        <a href="https://us.elvtr.com/course/become-game-writer" target="_blank" rel="noopener" class="currently-item currently-link">
          <div class="currently-img-wrap">
            <img src="/images/currentwork/ELVTR.jpg" alt="ELVTR Course" class="currently-img" />
          </div>
          <div class="currently-info">
            <span class="currently-tag tag-accent">Teaching</span>
            <span class="currently-text">Become a Game Writer course at ELVTR</span>
          </div>
        </a>
        <a href="/gdc2026" class="currently-item currently-link">
          <div class="currently-img-wrap">
            <img src="/images/currentwork/WriteBetweentheLines.jpg" alt="GDC 2026 Talk" class="currently-img" />
          </div>
          <div class="currently-info">
            <span class="currently-tag tag-coral">GDC 2026</span>
            <span class="currently-text">"Write Between the Lines" — Game Narrative Summit talk &amp; slides</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Work -->
  <section class="section featured">
    <div class="container">
      <div class="section-header">
        <span class="label">Featured Work</span>
        <h2>Award-winning narratives</h2>
      </div>
      <div class="grid grid-3">
        <div class="work-card card">
          <div class="work-card-img">
            <img src="/images/games/gow-ragnarok.jpg" alt="God of War: Ragnarök" />
          </div>
          <div class="work-card-body">
            <h3>God of War: Ragnar&ouml;k</h3>
            <p class="work-role">Senior Narrative Designer &amp; Writer — Santa Monica Studio</p>
            <p class="work-desc">Winner of Best Narrative at The Game Awards. Contributed to the story, dialogue, and narrative systems for the sequel to the 2018 Game of the Year.</p>
          </div>
        </div>

        <div class="work-card card">
          <div class="work-card-img">
            <img src="/images/games/god-of-war.webp" alt="God of War (2018)" />
          </div>
          <div class="work-card-body">
            <h3>God of War (2018)</h3>
            <p class="work-role">Narrative Designer &amp; Writer — Santa Monica Studio</p>
            <p class="work-desc">Winner of the 2019 WGA Award for Outstanding Video Game Writing and multiple BAFTA nominations.</p>
          </div>
        </div>

        <div class="work-card card">
          <div class="work-card-img">
            <img src="/images/games/horizon-fw.jpg" alt="Horizon Forbidden West" />
          </div>
          <div class="work-card-body">
            <h3>Horizon Forbidden West</h3>
            <p class="work-role">Narrative Designer — Guerrilla Games</p>
            <p class="work-desc">Worked on quest narrative and world storytelling for the open-world sequel to Horizon Zero Dawn.</p>
          </div>
        </div>
      </div>

      <div class="section-cta">
        <a href="/work" class="btn btn-outline">View Full Portfolio &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Services Preview -->
  <section class="section services-preview">
    <div class="container">
      <div class="section-header">
        <span class="label">What I Do</span>
        <h2>Consulting &amp; services</h2>
        <p>I work with studios, publishers, and indie teams across the full spectrum of narrative game development.</p>
      </div>

      <div class="grid grid-3">
        <div class="card service-card">
          <div class="service-icon">&#9998;</div>
          <h3>Writing &amp; Narrative Design</h3>
          <p>Story outlining, worldbuilding, dialogue writing, branching narrative, quest design, and lore development.</p>
        </div>

        <div class="card service-card">
          <div class="service-icon">&#127908;</div>
          <h3>Voice &amp; Performance</h3>
          <p>Voiceover direction, casting, performance capture coordination, and dialogue pipeline consulting.</p>
        </div>

        <div class="card service-card">
          <div class="service-icon">&#127891;</div>
          <h3>Coaching &amp; Mentorship</h3>
          <p>Writing team coaching, career mentorship, playtesting feedback, UX consulting, and team dynamics.</p>
        </div>
      </div>

      <div class="section-cta">
        <a href="/services" class="btn btn-outline">All Services &rarr;</a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta-section">
    <div class="container">
      <div class="cta-box">
        <h2>Let's build something great together.</h2>
        <p>Whether you need a narrative consultant for your next project, a writing mentor for your team, or just want to talk story — I'd love to hear from you.</p>
        <a href="/contact" class="btn btn-primary">Get in Touch</a>
      </div>
    </div>
  </section>

  <!-- Studios / Industry Experience -->
  <section class="section studios-section">
    <div class="container">
      <div class="section-header" style="text-align: center;">
        <span class="label">Industry Experience</span>
        <h2>Studios I've worked with</h2>
      </div>

      <div class="studios-grid">
        {studios.map((studio) => (
          <div class="studio-card" data-studio={studio.slug}>
            <a href={`/work#${studio.slug}`} class="studio-card-link">
              <div class="studio-logo-wrap">
                {studio.logo ? (
                  <img src={studio.logo} alt={studio.name} class="studio-logo" />
                ) : (
                  <span class="studio-logo-placeholder">{studio.name}</span>
                )}
              </div>
              <div class="studio-projects">
                {studio.projects.map((project) => (
                  <div class="studio-project">
                    <span class="studio-project-title">{project.title}</span>
                    <span class="studio-project-role">{project.role}</span>
                  </div>
                ))}
                <span class="studio-view-link">View work &rarr;</span>
              </div>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding: var(--space-4xl) 0;
    min-height: calc(70vh - var(--nav-height));
    display: flex;
    align-items: center;
  }

  .hero-layout {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3xl);
  }

  .hero-content {
    max-width: 720px;
    flex: 1;
  }

  .hero-logo {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-logo img {
    width: 280px;
    height: 280px;
    object-fit: contain;
    filter: drop-shadow(0 4px 24px rgba(232, 160, 112, 0.15));
  }

  .hero h1 {
    margin-bottom: var(--space-lg);
    letter-spacing: -0.03em;
  }

  .hero-sub {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: var(--space-2xl);
  }

  .hero-sub strong {
    color: var(--color-white);
    font-weight: 500;
  }

  .hero-actions {
    display: flex;
    align-items: stretch;
    gap: var(--space-md);
    flex-wrap: nowrap;
  }

  .hero-actions .btn {
    white-space: nowrap;
  }

  .social-btn {
    padding: 0.75rem;
    flex-shrink: 0;
    color: var(--color-blue);
  }

  .social-btn:hover {
    color: var(--color-blue-hover);
  }

  .social-btn svg {
    width: 20px;
    height: 20px;
  }

  /* Work Cards */
  .work-card {
    padding: 0;
    overflow: hidden;
  }

  .work-card-img {
    width: 100%;
    height: 200px;
    overflow: hidden;
    background: var(--color-surface);
  }

  .work-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .work-card:hover .work-card-img img {
    transform: scale(1.03);
  }

  .work-card-body {
    padding: var(--space-lg);
  }

  .work-card-body h3 {
    margin-bottom: var(--space-xs);
    font-size: 1.125rem;
  }

  .work-role {
    font-size: 0.8125rem;
    color: var(--color-accent);
    margin-bottom: var(--space-sm);
  }

  .work-desc {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  /* Services */
  .service-card {
    text-align: left;
  }

  .service-icon {
    font-size: 1.75rem;
    margin-bottom: var(--space-md);
  }

  .service-card h3 {
    font-size: 1.0625rem;
    margin-bottom: var(--space-sm);
  }

  .service-card p {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  .services-preview {
    background: var(--color-bg-alt);
  }

  /* Section CTA */
  .section-cta {
    margin-top: var(--space-2xl);
    text-align: center;
  }

  /* CTA Box */
  .cta-box {
    text-align: center;
    padding: var(--space-3xl);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 16px;
  }

  .cta-box h2 {
    margin-bottom: var(--space-md);
  }

  .cta-box p {
    max-width: 560px;
    margin: 0 auto var(--space-xl);
    color: var(--color-text-muted);
    font-size: 1.0625rem;
  }

  /* Currently Working On */
  .currently-section {
    padding: var(--space-2xl) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-alt);
  }

  .currently-bar {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .currently-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 6px var(--color-accent), 0 0 12px rgba(232, 160, 112, 0.4);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 6px var(--color-accent), 0 0 12px rgba(232, 160, 112, 0.4); }
    50% { opacity: 0.7; box-shadow: 0 0 10px var(--color-accent), 0 0 20px rgba(232, 160, 112, 0.3); }
  }

  .currently-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    text-shadow: 0 0 8px rgba(232, 160, 112, 0.5);
  }

  .currently-items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    justify-content: center;
    align-items: flex-start;
  }

  .currently-item {
    display: inline-flex;
    flex-direction: column;
    max-width: 300px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    overflow: hidden;
    transition: border-color var(--transition-base);
  }

  .currently-item:hover {
    border-color: var(--color-sage);
  }

  .currently-img-wrap {
    overflow: hidden;
  }

  .currently-img {
    display: block;
    width: 100%;
    height: auto;
  }

  .currently-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-sm) var(--space-md) var(--space-md);
    min-width: 0;
    opacity: 0;
    max-height: 0;
    padding: 0 var(--space-md);
    overflow: hidden;
    transition: opacity var(--transition-base), max-height var(--transition-base), padding var(--transition-base);
  }

  .currently-item:hover .currently-info {
    opacity: 1;
    max-height: 100px;
    padding: var(--space-sm) var(--space-md) var(--space-md);
  }

  .currently-tag {
    font-size: 0.6875rem;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    background: var(--color-sage-dim);
    color: var(--color-sage);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
    align-self: flex-start;
  }

  .tag-coral {
    background: rgba(216, 136, 120, 0.15);
    color: var(--color-coral);
  }

  .tag-blue {
    background: var(--color-blue-dim);
    color: var(--color-blue);
  }

  .tag-accent {
    background: var(--color-accent-dim);
    color: var(--color-accent);
  }

  .currently-text {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .currently-link {
    text-decoration: none;
    transition: border-color var(--transition-base);
  }

  .currently-link:hover .currently-text {
    color: var(--color-white);
  }

  /* Studios Section */
  .studios-section {
    background: var(--color-bg-alt);
  }

  .studios-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg);
  }

  .studio-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    transition: border-color var(--transition-base);
  }

  .studio-card:hover {
    border-color: var(--color-accent);
  }

  .studio-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .studio-logo-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-xl) var(--space-lg);
    min-height: 100px;
    background: var(--color-surface);
    transition: background var(--transition-base);
  }

  .studio-card:hover .studio-logo-wrap {
    background: var(--color-bg-card);
  }

  .studio-logo {
    height: 40px;
    width: auto;
    max-width: 140px;
    object-fit: contain;
    filter: grayscale(1) brightness(0.7);
    opacity: 0.7;
    transition: all var(--transition-base);
  }

  .studio-card:hover .studio-logo {
    filter: grayscale(0) brightness(1);
    opacity: 1;
  }

  .studio-logo-placeholder {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-dim);
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: color var(--transition-base);
  }

  .studio-card:hover .studio-logo-placeholder {
    color: var(--color-text);
  }

  /* Projects reveal */
  .studio-projects {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s ease, padding 0.35s ease;
    padding: 0 var(--space-lg);
  }

  .studio-card:hover .studio-projects {
    max-height: 300px;
    padding: var(--space-md) var(--space-lg) var(--space-lg);
  }

  .studio-project {
    display: flex;
    flex-direction: column;
    padding: var(--space-xs) 0;
  }

  .studio-project + .studio-project {
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-xs);
    padding-top: var(--space-sm);
  }

  .studio-project-title {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-white);
  }

  .studio-project-role {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .studio-view-link {
    display: inline-block;
    margin-top: var(--space-sm);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-accent);
    transition: color var(--transition-fast);
  }

  .studio-card:hover .studio-view-link {
    color: var(--color-accent-hover);
  }

  @media (max-width: 1024px) {
    .studios-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: var(--space-3xl) 0;
      min-height: auto;
    }

    .hero-layout {
      flex-direction: column;
      text-align: center;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-logo img {
      width: 200px;
      height: 200px;
    }

    .currently-items {
      justify-content: center;
    }

    .currently-img {
      max-height: 140px;
    }

    .studios-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .studios-grid {
      grid-template-columns: 1fr;
    }

    .hero-actions {
      gap: var(--space-sm);
    }

    .hero-actions .btn {
      padding: 0.625rem 0.875rem;
      font-size: 0.875rem;
    }

    .social-btn {
      padding: 0.625rem;
    }
  }
</style>
