---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found — Adam Dolin" description="This page doesn't exist — but plenty of others do.">

  <section class="section">
    <div class="container">
      <div class="notfound-content">
        <span class="label">404</span>
        <h1>This page wandered off the critical path.</h1>
        <p class="notfound-intro">
          Whatever you were looking for isn't here — it may have moved, or the link may be broken.
          Let's get you back to somewhere real.
        </p>
        <div class="notfound-actions">
          <a href="/" class="btn btn-primary">Back to Home</a>
          <a href="/contact" class="btn btn-outline">Get in Touch</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .notfound-content {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
    padding: var(--space-3xl) 0;
  }

  .notfound-content h1 {
    margin-bottom: var(--space-md);
  }

  .notfound-intro {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: var(--space-2xl);
  }

  .notfound-actions {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
